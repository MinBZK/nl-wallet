{
  "name": "nl-wallet-web",
  "version": "0.6.0-dev",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nl-wallet-web.umd.cjs",
  "module": "./dist/nl-wallet-web.js",
  "exports": {
    ".": {
      "import": "./dist/nl-wallet-web.js",
      "require": "./dist/nl-wallet-web.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format-check": "prettier --check lib/ util/",
    "format": "prettier --write lib/ util/",
    "extract-style-hash": "node --disable-warning=ExperimentalWarning --experimental-strip-types util/extract-style-hash.ts"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "allure-vitest": "^3.13.0",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jest-canvas-mock": "^2.5.8",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
