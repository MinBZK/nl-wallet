{
  "vct": "urn:eudi:pid:nl:1",
  "name": "NL PID credential",
  "description": "Working version of the Dutch PID credential",
  "extends": "urn:eudi:pid:1",
  "extends#integrity": "sha256-esZaRHLFytDKOfTf9BkXKexLcq1A3fBRPhC44J7Yjw4=",
  "display": [
    {
      "locale": "en-US",
      "name": "Personal data",
      "description": "The Dutch personal data credential",
      "summary": "{{given_name}}",
      "rendering": {
        "simple": {
          "background_color": "#C7E8EE",
          "text_color": "#152A62"
        }
      }
    },
    {
      "locale": "nl-NL",
      "name": "Persoonsgegevens",
      "description": "De Nederlandse persoonsgegevensattestatie",
      "summary": "{{given_name}}",
      "rendering": {
        "simple": {
          "background_color": "#C7E8EE",
          "text_color": "#152A62"
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["family_name"],
      "display": [
        {
          "locale": "en-US",
          "label": "Name",
          "description": "Family name of the person, including any prefixes"
        },
        {
          "locale": "nl-NL",
          "label": "Achternaam",
          "description": "Achternaam van de persoon, inclusief voorvoegsels"
        }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["given_name"],
      "display": [
        {
          "locale": "en-US",
          "label": "First name",
          "description": "First name of the person"
        },
        {
          "locale": "nl-NL",
          "label": "Voornaam",
          "description": "Voornaam van de persoon"
        }
      ],
      "sd": "always",
      "mandatory": true,
      "svg_id": "given_name"
    },
    {
      "path": ["birthdate"],
      "display": [
        {
          "locale": "en-US",
          "label": "Birth date",
          "description": "Birth date of the person"
        },
        {
          "locale": "nl-NL",
          "label": "Geboortedatum",
          "description": "Geboortedatum van de persoon"
        }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["nationalities"],
      "display": [
        {
          "locale": "en-US",
          "label": "Nationalities",
          "description": "List of nationalities of the person"
