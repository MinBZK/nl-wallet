{
  "vct": "org.iso.18013.5.1.mDL",
  "name": "Mobile Driver's Licence",
  "description": "ISO 18013-5 mobile driver's licence (mdoc only)",
  "display": [
    {
      "locale": "en-US",
      "name": "Driver's Licence",
      "description": "A mobile driver's licence",
      "summary": "{{driving_privileges}}",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "data:image/svg+xml;base64,",
            "alt_text": "EU/NL badge"
          },
          "background_color": "#FFC2AD",
          "text_color": "#152A62"
        }
      }
    },
    {
      "locale": "nl-NL",
      "name": "Rijbewijs",
      "description": "Een mobiel rijbewijs",
      "summary": "{{driving_privileges}}",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "data:image/svg+xml;base64,",
            "alt_text": "EU/NL badge"
          },
          "background_color": "#FFC2AD",
          "text_color": "#152A62"
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["family_name"],
      "display": [
        { "locale": "nl-NL", "label": "Achternaam", "description": "Achternaam van de rijbewijshouder" },
        { "locale": "en-US", "label": "Family name", "description": "Family name of the licence holder" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["given_name"],
      "display": [
        { "locale": "nl-NL", "label": "Voornaam", "description": "Voornaam van de rijbewijshouder" },
        { "locale": "en-US", "label": "Given name", "description": "Given name of the licence holder" }
      ],
      "sd": "always",
      "mandatory": true,
      "svg_id": "given_name"
    },
    {
      "path": ["birth_date"],
      "display": [
        { "locale": "nl-NL", "label": "Geboortedatum", "description": "Geboortedatum van de houder" },
        { "locale": "en-US", "label": "Date of birth", "description": "Date of birth of the holder" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["issue_date"],
      "display": [
        { "locale": "nl-NL", "label": "Afgiftedatum", "description": "Datum van afgifte van het rijbewijs" },
        { "locale": "en-US", "label": "Issue date", "description": "Date the licence was issued" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["expiry_date"],
      "display": [
        { "locale": "nl-NL", "label": "Vervaldatum", "description": "Datum waarop het rijbewijs vervalt" },
        { "locale": "en-US", "label": "Expiry date", "description": "Date the licence expires" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["issuing_country"],
      "display": [
        { "locale": "nl-NL", "label": "Uitgevend land", "description": "Land dat het rijbewijs heeft afgegeven" },
        { "locale": "en-US", "label": "Issuing country", "description": "Country that issued the licence" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["issuing_authority"],
      "display": [
        {
          "locale": "nl-NL",
          "label": "Uitgevende instantie",
          "description": "Instantie die het rijbewijs heeft afgegeven"
        },
        { "locale": "en-US", "label": "Issuing authority", "description": "Authority that issued the licence" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["document_number"],
      "display": [
        { "locale": "nl-NL", "label": "Documentnummer", "description": "Uniek documentnummer van het rijbewijs" },
        { "locale": "en-US", "label": "Document number", "description": "Unique document number of the licence" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["portrait"],
      "display": [
        { "locale": "nl-NL", "label": "Portretfoto", "description": "Foto van de rijbewijshouder (base64)" },
        { "locale": "en-US", "label": "Portrait", "description": "Photo of the licence holder (base64)" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["driving_privileges"],
      "display": [
        { "locale": "nl-NL", "label": "Rijbevoegdheden", "description": "Toegestane rijtuigcategorieën" },
        { "locale": "en-US", "label": "Driving privileges", "description": "Permitted vehicle categories" }
      ],
      "sd": "always",
      "mandatory": true,
      "svg_id": "driving_privileges"
    },
    {
      "path": ["un_distinguishing_sign"],
      "display": [
        { "locale": "nl-NL", "label": "Landcode", "description": "Internationaal onderscheidingsteken" },
        { "locale": "en-US", "label": "Country code", "description": "UN distinguishing sign" }
      ],
      "sd": "always",
      "mandatory": true
    }
  ]
}
