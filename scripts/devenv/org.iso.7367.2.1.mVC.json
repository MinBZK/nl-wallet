{
  "vct": "org.iso.7367.2.1.mVC",
  "name": "Vehicle Certificate",
  "description": "ISO/IEC 7367-2 mobile vehicle certificate (mdoc only)",
  "display": [
    {
      "locale": "en-US",
      "name": "Vehicle Certificate",
      "description": "A mobile vehicle certificate",
      "summary": "{{registration_number}}",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "data:image/svg+xml;base64,",
            "alt_text": "EU/NL badge"
          },
          "background_color": "#DCEED5",
          "text_color": "#152A62"
        }
      }
    },
    {
      "locale": "nl-NL",
      "name": "Kentekenbewijs",
      "description": "Een mobiel kentekenbewijs",
      "summary": "{{registration_number}}",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "data:image/svg+xml;base64,",
            "alt_text": "EU/NL badge"
          },
          "background_color": "#DCEED5",
          "text_color": "#152A62"
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["registration_number"],
      "display": [
        { "locale": "nl-NL", "label": "Kenteken", "description": "Kenteken van het voertuig" },
        { "locale": "en-US", "label": "Registration number", "description": "Registration number of the vehicle" }
      ],
      "sd": "always",
      "mandatory": true,
      "svg_id": "registration_number"
    },
    {
      "path": ["issue_date"],
      "display": [
        { "locale": "nl-NL", "label": "Afgegeven op", "description": "Datum van afgifte van het kentekenbewijs" },
        { "locale": "en-US", "label": "Issue date", "description": "Date the certificate was issued" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["expiry_date"],
      "display": [
        { "locale": "nl-NL", "label": "Geldig tot", "description": "Datum waarop het kentekenbewijs vervalt" },
        { "locale": "en-US", "label": "Valid until", "description": "Date the certificate expires" }
      ],
      "sd": "always"
    },
    {
      "path": ["issuing_authority_unicode"],
      "display": [
        {
          "locale": "nl-NL",
          "label": "Afgegeven op",
          "description": "Instantie die het kentekenbewijs heeft afgegeven"
        },
        { "locale": "en-US", "label": "Issued by", "description": "Authority that issued the certificate" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["issuing_authority_latin1"],
      "display": [
        {
          "locale": "nl-NL",
          "label": "Afgegeven door",
          "description": "Instantie die het kentekenbewijs heeft afgegeven"
        },
        {
          "locale": "en-US",
          "label": "Issuing authority",
          "description": "Authority that issued the certificate"
        }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["issuing_country"],
      "display": [
        {
          "locale": "nl-NL",
          "label": "Land van afgifte",
          "description": "Land dat het kentekenbewijs heeft afgegeven"
        },
        { "locale": "en-US", "label": "Issuing country", "description": "Country that issued the certificate" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["un_distinguishing_sign"],
      "display": [
        { "locale": "nl-NL", "label": "Landcode", "description": "Internationaal onderscheidingsteken" },
        { "locale": "en-US", "label": "Country code", "description": "UN distinguishing sign" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["document_number"],
      "display": [
        { "locale": "nl-NL", "label": "Documentnummer", "description": "Uniek documentnummer van het kentekenbewijs" },
        { "locale": "en-US", "label": "Document number", "description": "Unique document number of the certificate" }
      ],
      "sd": "always"
    },
    {
      "path": ["date_of_registration"],
      "display": [
        { "locale": "nl-NL", "label": "Geregistreerd op", "description": "Datum van registratie van het voertuig" },
        { "locale": "en-US", "label": "Date of registration", "description": "Date the vehicle was registered" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["date_of_first_registration"],
      "display": [
        {
          "locale": "nl-NL",
          "label": "Voor het eerst geregistreerd op",
          "description": "Datum van eerste registratie van het voertuig"
        },
        {
          "locale": "en-US",
          "label": "Date of first registration",
          "description": "Date of first registration of the vehicle"
        }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["chassis_number"],
      "display": [
        { "locale": "nl-NL", "label": "Chassisnummer", "description": "Voertuigidentificatienummer (VIN)" },
        { "locale": "en-US", "label": "Chassis number", "description": "Vehicle identification number (VIN)" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["basic_vehicle_info", "vehicle_category_code"],
      "display": [
        { "locale": "nl-NL", "label": "Voertuigcategorie", "description": "Europese voertuigcategorie" },
        { "locale": "en-US", "label": "Vehicle category", "description": "European vehicle category" }
      ],
      "sd": "always"
    },
    {
      "path": ["basic_vehicle_info", "make"],
      "display": [
        { "locale": "nl-NL", "label": "Merk", "description": "Merk van het voertuig" },
        { "locale": "en-US", "label": "Make", "description": "Make of the vehicle" }
      ],
      "sd": "always",
      "mandatory": true
    },
    {
      "path": ["basic_vehicle_info", "commercial_name"],
      "display": [
        { "locale": "nl-NL", "label": "Handelsbenaming", "description": "Handelsbenaming van het voertuig" },
        { "locale": "en-US", "label": "Commercial name", "description": "Commercial name of the vehicle" }
      ],
      "sd": "always"
    },
    {
      "path": ["owners"],
      "display": [
        { "locale": "nl-NL", "label": "Eigenaren", "description": "Eigenaar of eigenaren van het voertuig" },
        { "locale": "en-US", "label": "Owners", "description": "Owner(s) of the vehicle" }
      ],
      "sd": "always"
    }
  ]
}
