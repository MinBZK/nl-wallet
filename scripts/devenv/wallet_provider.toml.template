current_certificate_kid = "${WP_CERTIFICATE_KID}"
current_instruction_result_kid = "${WP_INSTRUCTION_RESULT_KID}"

wia_signing_key_identifier = "wia_signing_key"
wia_certificate = "${WP_WIA_CERTIFICATE}"
# wia_status_tracking_validity_in_days = 365
# wia_wallet_name = "NL Wallet"
# wia_wallet_link = "https://wallet.edi.rijksoverheid.nl"
wia_wallet_version = "${WALLET_VERSION}"
# wia_wallet_solution_certification_information = "https://wallet.edi.rijksoverheid.nl"

# Refresh delay in seconds for background job that refreshes flags
# flags_refresh_delay_in_seconds = 300

# Indicates if the revoke-solution API endpoint should be enabled
revoke_solution_enabled = true

# Indicates whether logging should be output in a structured (JSON) manner.
#structured_logging = false

pid_issuer_trust_anchors = ["${ISSUER_CA_CRT}"]

# Admin Portal OIDC login, see wallet_docs/development/keycloak-setup.md
[admin_portal]
keycloak_url = "https://${SERVICES_HOST}:${KC_PORT_HTTPS}"
keycloak_realm = "nl-wallet"
keycloak_client_id = "wallet-backend"
keycloak_trust_anchors = ["${KEYCLOAK_CA_CRT}"]
public_url = "http://${SERVICES_HOST}:5173"
session_ttl_in_ms = 900_000
login_attempt_ttl_in_ms = 600_000

[attestation_wrapping_kid]
current = "${WP_ATTESTATION_WRAPPING_KID}"

[pin_pubkey_encryption_kid]
current = "${WP_PIN_PUBKEY_ENCRYPTION_KID}"

[recovery_code_paths]
"urn:eudi:pid:nl:1" = ["recovery_code"]

[database]
url = "postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/wallet_provider"
options = { acquire_timeout_in_sec = 5, connect_timeout_in_sec = 1, max_connections = 5 }

[audit_log]
url = "postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/wallet_provider_audit_log"
options = { acquire_timeout_in_sec = 5, connect_timeout_in_sec = 1, max_connections = 5 }

[wia_status_list]
list_size = 100
base_url = "https://${SERVICES_HOST}:${STATIC_SERVER_PORT}/wia"
publish_dir = "${WALLET_CORE_DIR}/target/status-lists/wallet_provider"
key_identifier = "wia_tsl_key"
key_certificate = "${WIA_TSL_CRT}"

[webserver]
ip = "0.0.0.0"
port = ${WALLET_PROVIDER_PORT}

[tls_config]
cert = "${WALLET_PROVIDER_SERVER_CERT}"
key = "${WALLET_PROVIDER_SERVER_KEY}"

[pin_policy]
# rounds = 4
# attempts_per_round = 4
# timeouts_in_ms = [60_000, 300_000, 3_600_000]

[hsm]
library_path = "${HSM_LIBRARY_PATH}"
user_pin = "${HSM_USER_PIN}"
max_sessions = 3
max_session_lifetime_in_sec = 900

[ios]
team_identifier = "XGL6UKBPLP"
bundle_identifier = "nl.ictu.edi.wallet.latest"
environment = "development"
root_certificates = [
    "${APPLE_ROOT_CA}",
    "${MOCK_APPLE_ROOT_CA}"
]

[android]
root_public_keys = [
    "${ANDROID_ROOT_RSA_PUBKEY}",
    "${ANDROID_ROOT_EC_PUBKEY}",
]
package_name = "nl.ictu.edi.wallet.latest"
allow_sideloading = true
